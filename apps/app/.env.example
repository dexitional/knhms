# Copy to .env.local for local dev, or .env.production for deploys.
# Must match packages/db's DATABASE_URL (same MySQL instance, database `knh`).
DATABASE_URL="mysql://root:your_password_here@localhost:3306/knh"

# Three fully independent auth systems (student, admin, seller) — each needs
# its own session secret so a compromise of one cookie type can't be used to
# forge sessions for the others.
STUDENT_SESSION_SECRET=your_random_secret_here_min_32_chars
ADMIN_SESSION_SECRET=your_random_secret_here_min_32_chars
SELLER_SESSION_SECRET=your_random_secret_here_min_32_chars

# Public app origin. Used server-side only, to build the registration QR
# code's target URL (new URL("/register", APP_URL)) — never re-read in the
# browser, so it doesn't need a VITE_-prefixed client-side equivalent.
APP_URL=http://localhost:3000

# Cloudflare R2 (passport photos, payment receipts, admin staff photos).
# The bucket's CORS policy must allow PUT from APP_URL's origin.
R2_REGION=auto
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_DOMAIN=https://cdn.your-domain.example

# SMS provider for one-time codes and seller notifications (approval,
# rejection, suspension, password resets). Two swappable Ghana-based
# gateways are supported — SMS_PROVIDER picks which one is active
# (smsonlinegh, the default, or mnotify); only that provider's key needs to
# be set. Without a key
# set for the active provider, OTPs are logged to the server console instead
# of actually being sent — fine for local dev, never for production.
SMS_PROVIDER=smsonlinegh

MNOTIFY_API_KEY=your_mnotify_api_key
MNOTIFY_SENDER_ID=KNH

SMSONLINEGH_API_KEY=your_smsonlinegh_api_key
SMSONLINEGH_SENDER_ID=KNHALL
