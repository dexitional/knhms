DATABASE_URL="mysql://root:your_password_here@localhost:3306/knh"

# One-time seed script — the only way an initial admin account gets created
# (no setup wizard). Re-running the script is idempotent (upserts by email,
# rotating the password if it already exists).
SEED_ADMIN_NAME="System Administrator"
SEED_ADMIN_STAFF_NUMBER="ADM-0000"
SEED_ADMIN_EMAIL="admin@ucc.edu.gh"
SEED_ADMIN_PASSWORD="ChangeMe123!"
